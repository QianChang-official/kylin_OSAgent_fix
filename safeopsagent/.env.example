# SafeOpsAgent demo defaults.
# Copy to .env only when needed. Do not commit real API keys.

# Leave blank to default to the built-in safety planner without network or API keys.
# Set this explicitly to deepseek, qwen, kimi, custom, or offline_safe as needed.
MODEL_PROVIDER=
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_NAME=

# Optional vendor keys. Select MODEL_PROVIDER explicitly when more than one is set.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=

# Legacy generic provider variables remain supported.
LLM_PROVIDER=
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# Streamlit frontend target backend.
BACKEND_URL=http://127.0.0.1:8000

# Session lifecycle controls.
SESSION_TTL_SECONDS=1800
SESSION_MAX_MESSAGES=20

# /tools/call confirm dry-run token TTL.
CONFIRMATION_TTL_SECONDS=300

# Optional real console authentication. Generate the password verifier with:
#   python scripts/hash_console_password.py
# Generate the session secret with a system secret manager or:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CONSOLE_AUTH_ENABLED=0
CONSOLE_AUTH_USERNAME=
CONSOLE_AUTH_PASSWORD_HASH=
CONSOLE_AUTH_SESSION_SECRET=
CONSOLE_AUTH_SESSION_TTL_SECONDS=3600
CONSOLE_AUTH_SECURE_COOKIE=0
CONSOLE_LOGIN_ATTEMPT_LIMIT=5
CONSOLE_LOGIN_WINDOW_SECONDS=60

# Same-origin production traffic needs no CORS entry. These defaults support
# the local Vite development server only.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
