# SafeOpsAgent demo defaults.
# Copy to .env only when needed. Do not commit real API keys.

# Leave blank to default to the built-in safety planner without network or API keys.
# Set this explicitly to deepseek, qwen, kimi, custom, or offline_safe as needed.
MODEL_PROVIDER=
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_NAME=

# Optional vendor keys. Select MODEL_PROVIDER explicitly when more than one is set.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=

# Legacy generic provider variables remain supported.
LLM_PROVIDER=
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# Streamlit frontend target backend.
BACKEND_URL=http://127.0.0.1:8000

# Session lifecycle controls.
SESSION_TTL_SECONDS=1800
SESSION_MAX_MESSAGES=20

# /tools/call confirm dry-run token TTL.
CONFIRMATION_TTL_SECONDS=300

# Console authentication is enabled by default. Generate the password verifier with:
#   python scripts/hash_console_password.py
# Generate the session secret with a system secret manager or:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CONSOLE_AUTH_ENABLED=1
CONSOLE_AUTH_USERNAME=
CONSOLE_AUTH_PASSWORD_HASH=
CONSOLE_AUTH_SESSION_SECRET=
CONSOLE_AUTH_SESSION_TTL_SECONDS=3600
CONSOLE_AUTH_SECURE_COOKIE=0
CONSOLE_LOGIN_ATTEMPT_LIMIT=5
CONSOLE_LOGIN_WINDOW_SECONDS=60
CONSOLE_LOGIN_ATTEMPT_KEY_LIMIT=4096
# Keep this disabled. It exists only for isolated automated test harnesses.
CONSOLE_AUTH_ALLOW_INSECURE_NON_LOOPBACK=0

# Concealed entry gate. When a verifier is set, the public login becomes a decoy
# and the operator login is only served after this passphrase is accepted, so a
# client that never passes the gate cannot reach the password verifier at all.
# Leave blank to keep the familiar single-factor login.
# Generate with: python scripts/hash_console_password.py --entry-gate
CONSOLE_ENTRY_GATE_HASH=
CONSOLE_ENTRY_GATE_TTL_SECONDS=300
CONSOLE_ENTRY_GATE_ATTEMPT_LIMIT=5
CONSOLE_ENTRY_GATE_WINDOW_SECONDS=300

# Deception. Repeated failures on the decoy hand the client a sandbox session:
# the console renders normally but every response is fabricated and no real
# handler, tool or dataset is reachable from it.
HONEYPOT_ENABLED=1
HONEYPOT_TRIGGER_ATTEMPTS=3
HONEYPOT_SESSION_TTL_SECONDS=1800
HONEYPOT_HOSTNAME=kylin-app-07

# Attribution evidence is append-only and stays on this host. Reverse DNS is the
# only outbound lookup available and is off by default, so the default posture
# makes no network call and never signals the observed client.
DECEPTION_EVIDENCE_DIR=
DECEPTION_MAX_EVIDENCE_BYTES=33554432
DECEPTION_MAX_TRACKED_SOURCES=4096
DECEPTION_REVERSE_DNS=0
DECEPTION_REVERSE_DNS_TIMEOUT_SECONDS=1.0

# Only set this when SafeOpsAgent runs behind a reverse proxy you control.
# X-Forwarded-For is honoured solely when the immediate peer matches, otherwise
# any client could forge its own source address and evade rate limiting.
# Example: CONSOLE_TRUSTED_PROXIES=10.0.0.0/8,192.168.1.5
CONSOLE_TRUSTED_PROXIES=

# Same-origin production traffic needs no CORS entry. These defaults support
# the local Vite development server only.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional private directory containing completed, sealed Codex Security scans.
# It must be outside this repository. SafeOpsAgent only imports verified JSON.
CODEX_SECURITY_RESULTS_DIR=
